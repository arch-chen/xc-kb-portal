# ── 运行时生成 / 含真实数据，绝不入库 ──────────────────────────
/config.php
/storage/*.sqlite
/storage/*.sqlite-*
/storage/*.db
/storage/backups/*
/storage/tmp/*
!/storage/backups/.gitkeep
!/storage/tmp/.gitkeep

# 业务数据（微信群问答导出，私有资产）
/data/*.csv
/data/*.json
/data/*.xlsx

# 历史发布包（各版本 zip，体积大且含旧代码）
/dist/

# 本地测试站与测试夹具（含假支付数据、测试库、内部路径与口令）
/_test/

# 临时调试产物：排查页面结构时随手存下来的 html / txt / json 抓取结果
# （形如 _d1.html、_mp.html、_dbg.txt，常见于仓库根目录）
/_*.html
/_*.txt
/_*.json

# 升级/备份临时产物
*.zip
# 例外：仓库根 updates/ 里的在线更新包必须入库（后台 GitHub 一键更新要按清单下载）
!updates/
!updates/*.zip
*.bak
*.sql
*.log
*.tmp
*.swp
*~

# ── 编辑器 / 系统 ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.code-workspace

# ── 依赖 ────────────────────────────────────────────────────
/vendor/
/node_modules/
